{
  "$schema": "https://unpkg.com/flare-plugin-sdk@0.1.0-beta.10/skill/flare-plugin/manifest.schema.json",
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "dev.maxlec.zhihu",
  "version": "0.1.8",
  "defaultLocale": "zh-Hans",
  "name": { "key": "plugin.name", "fallback": "Zhihu" },
  "description": { "key": "plugin.description", "fallback": "Zhihu hot list, recommendations and answers" },
  "permissions": {
    "mediaNetwork": true
  },
  "platform": {
    "id": "zhihu",
    "name": { "key": "platform.name", "fallback": "Zhihu" },
    "detector": {
      "priority": 0
    },
    "loginMethods": [
      {
        "id": "browser",
        "interaction": "WebCookie",
        "title": { "key": "login.browser.title", "fallback": "Sign in with browser" },
        "cookie": {
          "startUrl": "$accountOrigin/signin?next=%2F",
          "probes": [
            {
              "url": "$accountOrigin/api/v4/me",
              "cookies": [
                { "name": "z_c0", "required": true },
                { "name": "d_c0", "required": true },
                { "name": "_xsrf", "required": false }
              ]
            }
          ]
        }
      }
    ],
    "capabilities": {
      "flare.datasource.timeline/v1": {
        "operations": {
          "page": {
            "directions": ["refresh", "older"]
          }
        }
      },
      "flare.datasource.article/v1": {
        "operations": {
          "detail": {},
          "comments": { "directions": ["refresh", "older"] }
        }
      },
      "flare.datasource.post/v1": {
        "operations": {
          "detail": {},
          "context": { "directions": ["refresh", "older"] },
          "mutate": {}
        }
      },
      "flare.datasource.tab-catalog/v1": {
        "operations": {
          "page": { "directions": ["refresh", "older"] }
        }
      },
      "flare.datasource.notification/v1": {
        "operations": {
          "page": { "directions": ["refresh", "older"] }
        },
        "notificationFilters": ["all"]
      },
      "flare.datasource.search/v1": {
        "operations": {
          "posts": { "directions": ["refresh", "older"] },
          "profiles": { "directions": ["refresh", "older"] },
          "discoverPosts": { "directions": ["refresh", "older"] },
          "discoverProfiles": { "directions": ["refresh", "older"] },
          "discoverHashtags": { "directions": ["refresh"] }
        }
      },
      "flare.datasource.compose/v1": {
        "operations": { "publish": {} }
      },
      "flare.datasource.profile/v1": {
        "operations": {
          "byId": {},
          "byHandle": {},
          "timeline": {},
          "following": {},
          "followers": {}
        }
      },
      "flare.datasource.relation/v1": {
        "operations": {
          "state": {},
          "mutate": {}
        },
        "relationActions": ["follow"]
      }
    },
    "composeDefaults": {
      "text": { "maxLength": 1000 },
      "visibility": { "allowed": ["public"], "default": "public" }
    },
    "timelines": [
      {
        "id": "recommend",
        "title": { "key": "timeline.recommend.title", "fallback": "Recommended" },
        "icon": "Home",
        "display": "List",
        "defaultForNewAccount": true
      },
      {
        "id": "hot",
        "title": { "key": "timeline.hot.title", "fallback": "Hot list" },
        "icon": "Featured",
        "display": "List"
      },
      {
        "id": "following",
        "title": { "key": "timeline.following.title", "fallback": "Following" },
        "icon": "Follow",
        "display": "List"
      }
    ],
    "deepLinks": [
      {
        "origin": "$accountOrigin",
        "path": [
          { "type": "literal", "value": "people" },
          { "type": "capture", "name": "handle" }
        ],
        "target": { "type": "Profile", "value": "{handle}" }
      }
    ],
    "profileTabs": [
      {
        "id": "answers",
        "title": { "key": "profileTab.answers", "fallback": "Answers" },
        "icon": "Reply",
        "display": "List"
      },
      {
        "id": "articles",
        "title": { "key": "profileTab.articles", "fallback": "Articles" },
        "icon": "List",
        "display": "List"
      },
      {
        "id": "pins",
        "title": { "key": "profileTab.pins", "fallback": "Pins" },
        "icon": "Messages",
        "display": "List"
      }
    ]
  }
}
